{
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"appPort": [
		"9123:8123"
	],
	"mounts": [
		"source=${localWorkspaceFolder}/../pyisyox,target=/workspaces/pyisyox,type=bind,consistency=cached"
	],
	"postCreateCommand": "bash .devcontainer/scripts/setup_ha_test_env.sh && bash .devcontainer/scripts/setup_homeassistant_runtime.sh || exit 1",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"github.vscode-pull-request-github",
				"ms-python.vscode-pylance",
				"ryanluker.vscode-coverage-gutters"
			],
			"settings": {
				"files.eol": "\n",
				"editor.tabSize": 4,
				"python.pythonPath": "/usr/bin/python3",
				"python.linting.pylintEnabled": true,
				"python.linting.enabled": true,
				"python.formatting.provider": "black",
				"editor.formatOnPaste": false,
				"editor.formatOnSave": true,
				"editor.formatOnType": true,
				"files.trimTrailingWhitespace": true
			}
		}
	}
}
